# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection (Authentication, Sessions, Security Tokens)
MONGODB_URI=mongodb://127.0.0.1:27017/food_waste_auth

# PostgreSQL Connection (Relational Business Entities & Agent Logs)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_waste_db?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET=food_waste_super_secret_access_key_2026_jwt_token
JWT_REFRESH_SECRET=food_waste_super_secret_refresh_key_2026_jwt_token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Uploads / Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# AI Agent Configuration
AGENT_EXECUTION_MODE=autonomous
AGENT_CONFIDENCE_THRESHOLD=0.75
