// This is your Prisma schema file for PostgreSQL (Business Entities)
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// 1. User Profiles (Referencing MongoDB User _id via userId)
// --------------------------------------------------------

model DonorProfile {
  id               String   @id @default(uuid())
  userId           String   @unique // References MongoDB User._id
  organizationName String
  contactPhone     String?
  address          String
  latitude         Float
  longitude        Float
  donorType        String   @default("RESTAURANT") // RESTAURANT, SUPERMARKET, HOUSEHOLD, EVENT_ORGANIZER, CORPORATE
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  donations Donation[]

  @@index([userId])
  @@index([latitude, longitude])
  @@map("donor_profiles")
}

model RecipientProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique // References MongoDB User._id
  organizationName    String
  recipientType       String   @default("SHELTER") // SHELTER, FOOD_BANK, COMMUNITY_KITCHEN, INDIVIDUAL, CHARITY
  contactPhone        String?
  address             String
  latitude            Float
  longitude           Float
  capacityMealsPerDay Int      @default(100)
  dietaryPreferences  String[] @default([]) // VEGAN, VEGETARIAN, HALAL, KOSHER, GLUTEN_FREE, NUT_FREE
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  matches Match[]

  @@index([userId])
  @@index([latitude, longitude])
  @@map("recipient_profiles")
}

model VolunteerProfile {
  id                String   @id @default(uuid())
  userId            String   @unique // References MongoDB User._id
  fullName          String
  contactPhone      String?
  vehicleType       String   @default("CAR") // BICYCLE, MOTORCYCLE, CAR, VAN, TRUCK
  vehicleCapacityKg Float    @default(50.0)
  isAvailable       Boolean  @default(true)
  currentLatitude   Float?
  currentLongitude  Float?
  activeHours       String?  @default("9:00 - 18:00")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  deliveries Delivery[]
  routes     Route[]

  @@index([userId])
  @@index([isAvailable])
  @@map("volunteer_profiles")
}

// --------------------------------------------------------
// 2. Donation & Freshness Assessment
// --------------------------------------------------------

enum DonationStatus {
  PENDING_ANALYSIS
  ANALYZED
  MATCH_PROPOSED
  MATCHED
  PICKED_UP
  DELIVERED
  EXPIRED
  CANCELLED
}

model Donation {
  id                String         @id @default(uuid())
  donorId           String
  title             String
  description       String?
  foodCategory      String         @default("COOKED_MEALS") // COOKED_MEALS, BAKERY, PRODUCE, PACKAGED, DAIRY, BEVERAGES
  quantityValue     Float
  quantityUnit      String         @default("KG") // KG, MEALS, BOXES, LITERS, ITEMS
  preparedAt        DateTime?
  expiryEstimatedAt DateTime?
  storageTemp       String?        @default("ROOM_TEMP") // FROZEN, REFRIGERATED, ROOM_TEMP, WARM
  status            DonationStatus @default(PENDING_ANALYSIS)
  imageUrls         String[]       @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  donor        DonorProfile         @relation(fields: [donorId], references: [id], onDelete: Cascade)
  items        DonationItem[]
  freshness    FreshnessAssessment?
  matches      Match[]
  deliveries   Delivery[]
  impactMetric ImpactMetric?

  @@index([donorId])
  @@index([status])
  @@index([createdAt])
  @@map("donations")
}

model DonationItem {
  id         String    @id @default(uuid())
  donationId String
  name       String
  quantity   Float
  unit       String    @default("KG")
  expiryDate DateTime?
  notes      String?

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([donationId])
  @@map("donation_items")
}

model FreshnessAssessment {
  id                String   @id @default(uuid())
  donationId        String   @unique
  freshnessScore    Float // 0 - 100
  safetyWindowHours Float // Estimated safe consumption window remaining
  confidenceScore   Float // 0.0 - 1.0
  visualDefectFlags String[] @default([]) // e.g. ["discoloration", "bruising", "safe"]
  recommendation    String // "SAFE_FOR_DONATION", "CONSUME_WITHIN_2H", "DISCARD"
  modelVersion      String   @default("rule-engine-v1.0")
  createdAt         DateTime @default(now())

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([freshnessScore])
  @@map("freshness_assessments")
}

// --------------------------------------------------------
// 3. AI Matches & Recipient Proposals
// --------------------------------------------------------

enum MatchStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  EXPIRED
}

model Match {
  id           String      @id @default(uuid())
  donationId   String
  recipientId  String
  matchScore   Float // 0 - 100 composite ranking
  distanceKm   Float
  urgencyScore Float       @default(50.0)
  status       MatchStatus @default(PROPOSED)
  matchedAt    DateTime    @default(now())
  respondedAt  DateTime?

  donation   Donation         @relation(fields: [donationId], references: [id], onDelete: Cascade)
  recipient  RecipientProfile @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@index([donationId])
  @@index([recipientId])
  @@index([status])
  @@map("matches")
}

// --------------------------------------------------------
// 4. Logistics, Deliveries & Routes
// --------------------------------------------------------

enum DeliveryStatus {
  ASSIGNED
  EN_ROUTE_PICKUP
  PICKED_UP
  EN_ROUTE_DROPOFF
  COMPLETED
  FAILED
  CANCELLED
}

model Delivery {
  id                    String         @id @default(uuid())
  donationId            String
  matchId               String?
  volunteerId           String?
  pickupAddress         String
  dropoffAddress        String
  status                DeliveryStatus @default(ASSIGNED)
  proofPhotoUrl         String?
  recipientSignatureUrl String?
  assignedAt            DateTime       @default(now())
  pickedUpAt            DateTime?
  completedAt           DateTime?

  donation  Donation          @relation(fields: [donationId], references: [id], onDelete: Cascade)
  match     Match?            @relation(fields: [matchId], references: [id], onDelete: SetNull)
  volunteer VolunteerProfile? @relation(fields: [volunteerId], references: [id], onDelete: SetNull)
  routes    Route[]

  @@index([donationId])
  @@index([volunteerId])
  @@index([status])
  @@map("deliveries")
}

model Route {
  id                     String   @id @default(uuid())
  deliveryId             String?
  volunteerId            String
  waypointsJson          String // JSON serialized waypoint array
  totalDistanceKm        Float    @default(0.0)
  estimatedDurationMin   Float    @default(0.0)
  optimizedRoutePolyline String?
  status                 String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt              DateTime @default(now())

  delivery  Delivery?        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@map("routes")
}

// --------------------------------------------------------
// 5. Notifications & Real-Time Alerts
// --------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

model Notification {
  id              String              @id @default(uuid())
  recipientUserId String // References MongoDB User._id
  title           String
  body            String
  channel         NotificationChannel @default(IN_APP)
  isRead          Boolean             @default(false)
  metadataJson    String?
  createdAt       DateTime            @default(now())

  @@index([recipientUserId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// --------------------------------------------------------
// 6. Impact Analytics & Carbon Metrics
// --------------------------------------------------------

model ImpactMetric {
  id               String   @id @default(uuid())
  donationId       String   @unique
  mealsRescued     Int      @default(0)
  co2AvoidedKg     Float    @default(0.0)
  waterSavedLiters Float    @default(0.0)
  peopleFed        Int      @default(0)
  calculatedAt     DateTime @default(now())

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@map("impact_metrics")
}

// --------------------------------------------------------
// 7. Agentic AI Job Execution Logs
// --------------------------------------------------------

enum AgentJobStatus {
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
}

model AgentJobLog {
  id                String         @id @default(uuid())
  agentName         String // e.g. "FoodAgent", "MatchingAgent", "LogisticsAgent"
  jobId             String         @unique
  inputPayloadJson  String
  outputPayloadJson String?
  executionTimeMs   Int?
  status            AgentJobStatus @default(QUEUED)
  error             String?
  createdAt         DateTime       @default(now())

  @@index([agentName])
  @@index([status])
  @@index([createdAt])
  @@map("agent_job_logs")
}
